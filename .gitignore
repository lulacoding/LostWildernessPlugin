# =============================================================================
# Lost Wilderness – repo-root .gitignore
# Private deployment-bundle repo.
# Covers: DiscordBot, Plugin (Gradle), Server, editor/OS noise.
# =============================================================================

# ─── DiscordBot ──────────────────────────────────────────────────────────────
DiscordBot/.env
DiscordBot/node_modules/
DiscordBot/dist/
DiscordBot/*.log

# ─── Plugin (Gradle) ─────────────────────────────────────────────────────────
Plugin/.gradle/
Plugin/**/build/
Plugin/**/bin/
Plugin/**/out/
Plugin/**/.idea/
Plugin/**/*.iml
Plugin/**/*.iws
Plugin/**/*.ipr

# ─── PluginV2 (Gradle) ───────────────────────────────────────────────────────
PluginV2/.gradle/
PluginV2/**/build/
PluginV2/**/bin/
PluginV2/**/out/
PluginV2/**/.idea/
PluginV2/**/*.iml
PluginV2/**/*.iws
PluginV2/**/*.ipr

# ─── Plugin JARs (never commit — all backends) ───────────────────────────────
Server/**/*.jar
PluginV2/**/build/libs/*.jar
PluginV2/plugins/*.jar

# ─── Server – runtime caches & generated artifacts ───────────────────────────
# Paper downloaded libraries
Server/backends/*/libraries/
Server/proxy/libraries/
# Paper version cache
Server/backends/*/versions/
Server/proxy/versions/
# Paper remapped plugin cache
Server/backends/*/plugins/.paper-remapped/
Server/proxy/plugins/.paper-remapped/
# Mojang jar cache
Server/backends/*/cache/
Server/proxy/cache/
# Server logs
Server/backends/*/logs/
Server/proxy/logs/
# Crash reports
Server/backends/*/crash-reports/
# Console history
Server/backends/*/.console_history
# Proxy runtime logs
Server/proxy/proxy.log*
Server/proxy/*.log
Server/proxy/*.log.*
# Session locks
Server/backends/*/.session.lock
Server/backends/*/session.lock

# ─── Server – world data (binary, runtime) ───────────────────────────────────
# Region, entity, poi chunk data
Server/backends/*/world/region/
Server/backends/*/world/entities/
Server/backends/*/world/poi/
Server/backends/*/world/mantle/
Server/backends/*/world/iris/
# Dimension sub-folders (nether/end portal data)
Server/backends/*/world/DIM-1/
Server/backends/*/world/DIM1/
# Player runtime data
Server/backends/*/world/playerdata/
Server/backends/*/world/advancements/
Server/backends/*/world/stats/
# World metadata (binary)
Server/backends/*/world/*.dat
Server/backends/*/world/*.dat_old
Server/backends/*/world/*.dat_tmp
Server/backends/*/world/uid.dat
# World misc runtime files
Server/backends/*/world/data/
Server/backends/*/world/session.lock
Server/backends/*/world/paper-world.yml
Server/backends/*/world/datapacks/bukkit/
# Nether and End worlds (full — no datapacks to keep there)
Server/backends/*/world_nether/
Server/backends/*/world_the_end/
Server/backends/*/world_*/

# ─── Server – sensitive / runtime state ──────────────────────────────────────
# Private keys
Server/**/floodgate/key.pem
Server/**/*.pem
# Runtime SQLite databases
Server/**/*.db
# Player/ban/op/whitelist runtime data
Server/backends/*/ops.json
Server/backends/*/usercache.json
Server/backends/*/whitelist.json
Server/backends/*/banned-players.json
Server/backends/*/banned-ips.json
Server/proxy/stats/

# ─── Server – third-party plugin folders (download separately) ───────────────
# Keep only our custom plugin configs; these are all downloadable
Server/backends/*/plugins/Iris/
Server/backends/*/plugins/FastAsyncWorldEdit/
Server/backends/*/plugins/WorldEdit/
Server/backends/*/plugins/WorldGuard/

# ─── Server – AuraSkills runtime data (keep configs, ignore player/region data)
Server/backends/*/plugins/AuraSkills/userdata/
Server/backends/*/plugins/AuraSkills/backups/
Server/backends/*/plugins/AuraSkills/regiondata/

# ─── Server – wepif (WorldEdit permissions, auto-generated) ──────────────────
Server/backends/*/wepif.yml

# ─── AI tool local state (never commit) ──────────────────────────────────────
.serena/
.playwright-mcp/
.claude/settings.local.json

# ─── Editor / OS noise ───────────────────────────────────────────────────────
.vscode/
.idea/
*.DS_Store
Thumbs.db
desktop.ini

# ─── Cursor IDE local files ───────────────────────────────────────────────────
.cursor/plans/

# ─── Secrets (never commit live values) ──────────────────────────────────────
*.env
.env.*
!.env.example
!**/.env.example
