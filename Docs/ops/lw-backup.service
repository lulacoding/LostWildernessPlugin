# systemd service: Lost Wilderness nightly backup
# Deploy to: /etc/systemd/system/lw-backup.service
#
# Runs: DB dump → world archives → prune old backups
#
# Install:
#   sudo cp Docs/ops/lw-backup.service /etc/systemd/system/lw-backup.service
#   sudo cp Docs/ops/lw-backup.timer   /etc/systemd/system/lw-backup.timer
#   sudo systemctl daemon-reload
#   sudo systemctl enable lw-backup.timer
#   sudo systemctl start  lw-backup.timer
#
# Test a manual run:
#   sudo systemctl start lw-backup.service
#   sudo journalctl -u lw-backup.service -f

[Unit]
Description=Lost Wilderness nightly backup (DB + worlds + prune)
After=network.target mariadb.service

[Service]
Type=oneshot
User=root

# Adjust paths if you deploy scripts elsewhere
ExecStart=/bin/bash /opt/lostwilderness/Docs/ops/mariadb-backup.sh
ExecStart=/bin/bash /opt/lostwilderness/Docs/ops/world-backup.sh
ExecStart=/bin/bash /opt/lostwilderness/Docs/ops/prune-backups.sh

# Allow up to 2 hours for slow backups
TimeoutStartSec=7200

StandardOutput=journal
StandardError=journal
