# Lost Wilderness ops environment variables
# Copy to /etc/lw-ops.env and fill in real values.
# Referenced by systemd units via EnvironmentFile=/etc/lw-ops.env
#
# CRITICAL: chmod 600 and chown root:root after copying.
#
#   sudo cp Docs/ops/lw-ops.env.example /etc/lw-ops.env
#   sudo chmod 600 /etc/lw-ops.env
#   sudo chown root:root /etc/lw-ops.env

# Discord webhook URL for infra-alerts channel.
# Create one in: Discord server settings → Integrations → Webhooks
DISCORD_INFRA_WEBHOOK=CHANGE_ME__DISCORD_WEBHOOK_URL

# Base path for Paper backends (used by backup/crash scripts)
MC_BASE=/opt/lostwilderness/Server/backends
